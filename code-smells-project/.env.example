# Copie para .env (ou exporte no shell) e ajuste. Nenhum valor real aqui.

# Chave de assinatura de sessões e tokens. OBRIGATÓRIA em produção.
SECRET_KEY=

# Token das rotas /admin. Vazio = acesso administrativo negado (fail-closed).
ADMIN_TOKEN=

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Banco de dados
DATABASE_PATH=loja.db
SEED_ON_STARTUP=1

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
