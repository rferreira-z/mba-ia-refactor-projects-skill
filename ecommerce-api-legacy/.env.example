# Copie para .env (ou exporte no ambiente) e preencha com valores reais.
# Nenhum valor real deve ser versionado.

# Porta HTTP da aplicação (padrão: 3000)
PORT=3000

# Arquivo SQLite. ':memory:' (padrão) recria o banco com seeds a cada boot.
DATABASE_FILE=:memory:

# Nível de log: error | warn | info | debug (padrão: info)
LOG_LEVEL=info

# Credencial exigida no header X-Admin-Token pelas rotas administrativas e
# destrutivas. Sem este valor, essas rotas respondem 403.
ADMIN_TOKEN=

# Chave do gateway de pagamento. Obrigatória quando NODE_ENV=production.
PAYMENT_GATEWAY_KEY=
