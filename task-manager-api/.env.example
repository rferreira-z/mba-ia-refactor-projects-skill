# Copie para `.env` e ajuste. Nenhum valor real deve ser commitado.
# Todos os valores abaixo são opcionais: sem eles a app sobe com defaults de desenvolvimento.

# Segurança — OBRIGATÓRIO definir em produção
SECRET_KEY=dev-only-change-me
ADMIN_TOKEN=dev-admin-token-change-me
TOKEN_MAX_AGE_SECONDS=28800

# Banco de dados
DATABASE_URL=sqlite:///tasks.db

# Runtime
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# CORS: origens separadas por vírgula ('*' libera todas — não use em produção)
CORS_ORIGINS=http://localhost:3000

# Notificações por e-mail (desligadas enquanto SMTP_HOST estiver vazio)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
